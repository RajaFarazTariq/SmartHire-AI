# ---------------------------------------------------------------------------
# SmartHire-AI — environment variables
# Copy to .env.local and fill in the values you need. Most blocks are optional;
# leaving a block empty disables that feature without breaking the app.
# ---------------------------------------------------------------------------

# --- Database (required) ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Clerk auth (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AI providers (required) ---
GEMINI_API_KEY=
# Optional fallbacks
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Pinecone vector DB (required for resume search) ---
PINECONE_API_KEY=
PINECONE_INDEX=

# --- Vercel Blob (required for resume uploads) ---
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Optional: Email notifications via Resend
#
# Leaving RESEND_API_KEY unset disables email entirely. The app behaves
# exactly as before: in-app notifications still work, no log spam.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="SmartHire-AI <onboarding@resend.dev>"
# Absolute origin used to build CTA + unsubscribe links inside emails.
# Required only if RESEND_API_KEY is set. Falls back to VERCEL_URL on deploys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional safety cap to stay under Resend free-tier limits (default 80).
EMAIL_DAILY_CAP=80

# ---------------------------------------------------------------------------
# Optional: Vercel Cron secret
# Mandatory in production for /api/cron/interview-reminders.
# ---------------------------------------------------------------------------
CRON_SECRET=
