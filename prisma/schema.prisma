// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id // matches Clerk userId
  email       String   @unique
  username    String?  @unique // synced from Clerk; nullable for accounts created before username was required
  fullName    String? // synced from Clerk first + last name
  accountType String   @default("recruiter") // "recruiter" (org member) | "applicant" (self-service)
  createdAt   DateTime @default(now())

  jobs          Job[]
  candidates    Candidate[]
  activityLogs  ActivityLog[]
  notes         Note[]
  applications  Application[]      @relation("UserApplications")
  profile       CandidateProfile?
  notifications Notification[]
  preferences   NotificationPreference?

  @@map("users")
}

model Job {
  id              String   @id @default(cuid())
  userId          String // creator (Clerk userId)
  orgId           String? // owning Clerk organization
  title           String // e.g. "Senior Backend Engineer"
  company         String?
  description     String   @db.Text
  requiredSkills  String[] // ["Python", "PostgreSQL"]
  preferredSkills String[] // nice-to-haves
  minExperience   Int? // years
  pineconeId      String?
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  scores       Score[]
  applications Application[]
  interviews   Interview[]

  @@index([userId])
  @@index([orgId])
  @@map("jobs")
}

model Candidate {
  id                String   @id @default(cuid())
  userId            String // recruiter who uploaded
  orgId             String? // owning Clerk organization
  fullName          String?
  email             String?
  phone             String?
  filename          String
  fileUrl           String // Vercel Blob URL
  fileType          String // "pdf" | "docx"
  rawText           String   @db.Text // extracted plain text
  extractedSkills   String[]
  yearsExperience   Int?
  educationLevel    String?
  currentTitle      String?
  pineconeId        String?
  status            String   @default("processing") // AI pipeline: processing | ready | error
  stage             String   @default("Applied") // hiring pipeline (see lib/pipeline.ts)
  linkedinUrl       String? // applicant-supplied (self-service apply)
  githubUrl         String?
  portfolioUrl      String?
  coverNote         String?  @db.Text
  uploadedAt        DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  scores      Score[]
  notes       Note[]
  application Application?
  interviews  Interview[]

  @@index([userId])
  @@index([orgId])
  @@index([orgId, stage])
  @@map("candidates")
}

model Score {
  id              String   @id @default(cuid())
  jobId           String
  candidateId     String
  semanticScore   Float // 0-100, cosine similarity
  skillMatchScore Float // 0-100, % required matched
  experienceScore Float // 0-100, based on years
  overallScore    Float // 0-100, weighted composite
  matchedSkills   String[]
  missingSkills   String[]
  aiSummary       String?  @db.Text
  computedAt      DateTime @default(now())

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@map("scores")
}

model Note {
  id          String   @id @default(cuid())
  candidateId String
  userId      String
  body        String   @db.Text
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([candidateId, createdAt])
  @@map("notes")
}

model Application {
  id          String   @id @default(cuid())
  applicantId String // Clerk userId of the applicant
  jobId       String
  candidateId String   @unique // the resume/profile created for this application
  createdAt   DateTime @default(now())

  applicant User      @relation("UserApplications", fields: [applicantId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([applicantId, jobId])
  @@index([applicantId])
  @@index([jobId])
  @@map("applications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  orgId     String? // owning Clerk organization
  type      String // e.g. job.created, candidate.uploaded, candidates.scored, candidate.stage_changed
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@map("activity_logs")
}

// One-per-user profile for candidates (job seekers). Persists across
// applications so resume/skills/links are entered once and reused.
model CandidateProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  headline     String? // e.g. "Senior Frontend Engineer"
  location     String?
  phone        String?
  bio          String?  @db.Text
  skills       String[]
  certifications String[] // names of certifications/licenses
  experience   Json? // [{ title, company, period, description }]
  education    Json? // [{ school, degree, period }]
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  websiteUrl   String?
  resumeUrl    String? // primary resume (Vercel Blob)
  resumeName   String?
  resumeType   String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

// A scheduled interview between a candidate and a panel of interviewers.
model Interview {
  id             String   @id @default(cuid())
  orgId          String
  jobId          String
  candidateId    String
  scheduledAt    DateTime
  durationMins   Int      @default(45)
  type           String   @default("Phone Screen") // Phone Screen | Technical | Behavioral | System Design | Final
  meetingLink    String?
  location       String?
  status         String   @default("Scheduled") // Scheduled | Completed | Cancelled | No-show
  notes          String?  @db.Text
  interviewerIds String[] // Clerk userIds of the panel
  aiQuestions    Json? // [{ category, questions: string[] }]
  reminderSentAt DateTime? // null until the pre-interview reminder fires
  createdById    String // Clerk userId of the scheduler
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job       Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  feedback  InterviewFeedback[]

  @@index([orgId, scheduledAt])
  @@index([candidateId])
  @@index([jobId])
  @@map("interviews")
}

// A single interviewer's scorecard for an interview.
model InterviewFeedback {
  id             String   @id @default(cuid())
  interviewId    String
  interviewerId  String // Clerk userId
  rating         Int // 1-5
  recommendation String // Strong Yes | Yes | No | Strong No
  strengths      String?  @db.Text
  concerns       String?  @db.Text
  comments       String?  @db.Text
  candidateMessage String? @db.Text // shared WITH the candidate (the others are internal)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@map("interview_feedback")
}

// Per-organization configuration (e.g. which optional interview rounds are on).
model OrgSettings {
  id            String   @id @default(cuid())
  orgId         String   @unique
  enabledRounds String[] // optional interview rounds the org has enabled
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("org_settings")
}

// Tracks who created (founded) the org. Clerk owns the org record itself; we
// only need an immutable pointer to the founder so role-mgmt rules can enforce
// "original admin is permanent". Lazily created on first authenticated org
// request in requireWorkspace().
model Organization {
  orgId       String   @id // Clerk organization id
  name        String   @unique // surfaced collision via friendly error on ensureOrgRecord
  foundedById String // Clerk userId of the original/permanent admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([foundedById])
  @@map("organizations")
}

// A recruiter's request to join an existing Clerk organization. Created when
// they pick an org during onboarding; awaits an org admin's decision.
model OrganizationRequest {
  id             String    @id @default(cuid())
  orgId          String // target Clerk org id
  orgName        String // snapshot at request time
  requesterId    String // Clerk userId of the person asking to join
  requesterEmail String
  requesterName  String?
  message        String?   @db.Text
  status         String    @default("pending") // pending | approved | rejected
  decidedById    String? // admin's Clerk userId
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orgId, requesterId])
  @@index([orgId, status])
  @@index([requesterId, status])
  @@map("organization_requests")
}

// In-app notifications (status changes, interview updates, system messages).
model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String // application.status | application.submitted | system
  title      String
  body       String?
  link       String?
  read       Boolean   @default(false)
  emailedAt  DateTime? // set when the email side-effect succeeded
  emailError String? // populated when an email attempt failed (skipped, rate-limited, etc.)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Per-user email opt-out + per-type granular preferences. Default = opted-in;
// row is lazily created on first notification or first visit to /portal/preferences.
model NotificationPreference {
  userId           String   @id
  emailEnabled     Boolean  @default(true)
  // Per-type opt-out map, e.g. { "application.status": false }. Missing keys = on.
  types            Json?
  unsubscribeToken String   @unique @default(cuid())
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
